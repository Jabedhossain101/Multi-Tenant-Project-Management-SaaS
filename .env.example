# ==============================================================================
# ENVIRONMENT CONFIGURATION EXAMPLE (.env.example)
# Multi-Tenant AI Project Management SaaS
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=5000

# Client Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:5000

# Database Configuration (PostgreSQL with Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saas_db?schema=public

# Redis Configuration (BullMQ, Caching, Rate Limiting)
REDIS_URL=redis://localhost:6379

# JWT Authentication Secrets
JWT_ACCESS_SECRET=super_secret_access_jwt_key_at_least_32_characters_long
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_at_least_32_characters_long
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
COOKIE_SECRET=super_secret_cookie_signing_key_at_least_32_characters

# Google Gemini AI API
GEMINI_API_KEY=your_google_gemini_api_key_here

# Stripe Payments & Subscriptions
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_BUSINESS_MONTHLY=price_...
STRIPE_PRICE_BUSINESS_YEARLY=price_...

# S3-Compatible Object Storage (AWS S3, MinIO, Cloudflare R2)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=saas-storage
S3_FORCE_PATH_STYLE=true

# Email Service (SMTP / Resend / SendGrid)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@tasksaas.local

# Super Admin Initial Credentials (Used during initial idempotent seeding)
SUPER_ADMIN_EMAIL=superadmin@tasksaas.local
SUPER_ADMIN_PASSWORD=AdminSecurePassword123!
